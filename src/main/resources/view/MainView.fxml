<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane fx:id="rootStackPane" minWidth="1200.0" minHeight="650.0" xmlns="http://javafx.com/javafx/8"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.ray.atten.desktop.presentation.controller.MainController">

    <BorderPane fx:id="mainContainer">
        <left>
            <VBox prefWidth="220.0" spacing="5.0" styleClass="sidebar">
                <children>
                    <VBox alignment="CENTER" spacing="10.0">
                        <VBox.margin>
                            <Insets bottom="10.0" top="30.0"/>
                        </VBox.margin>
                        <children>
                            <ImageView fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@/images/logo.png"/>
                                </image>
                            </ImageView>
                            <Label text="考勤管理系统" styleClass="sidebar-title">
                                <font>
                                    <Font name="System Bold" size="16.0"/>
                                </font>
                                <style>
                                    -fx-text-fill: white;
                                    -fx-opacity: 0.9;
                                </style>
                            </Label>
                        </children>
                    </VBox>

                    <VBox alignment="CENTER" spacing="5.0">
                        <VBox.margin>
                            <Insets bottom="25.0" />
                        </VBox.margin>
                        <children>
                            <Label text="欢迎回来," style="-fx-text-fill: #aaaaaa; -fx-font-size: 11px;" />
                            <HBox alignment="CENTER" spacing="8.0">
                                <children>
                                    <Label fx:id="lblAdminName" text="管理员"
                                           style="-fx-text-fill: #2196F3; -fx-font-size: 14px; -fx-font-weight: bold;" />
                                    <Hyperlink onAction="#handleLogout" text="[注销]"
                                               style="-fx-text-fill: #ff6b6b; -fx-font-size: 11px; -fx-padding: 0; -fx-underline: false; -fx-border-color: transparent;" />
                                </children>
                            </HBox>
                        </children>
                    </VBox>

                    <Button fx:id="btnEmployee" onAction="#showEmployeeView" prefHeight="50.0" prefWidth="220.0"
                            text=" 👥 员工管理" styleClass="nav-button"/>
                    <Button fx:id="btnAttendance" onAction="#showAttendanceView" prefHeight="50.0" prefWidth="220.0"
                            text=" 📅 考勤统计" styleClass="nav-button"/>
                    <Button fx:id="btnDevice" onAction="#showDeviceView" prefHeight="50.0" prefWidth="220.0"
                            text=" 🛠 设备管理" styleClass="nav-button"/>

                    <VBox fx:id="adminMenuSection" visible="false" managed="false" spacing="5.0">
                        <children>
                            <Separator opacity="0.1">
                                <VBox.margin>
                                    <Insets left="20.0" right="20.0" top="10.0" bottom="10.0"/>
                                </VBox.margin>
                            </Separator>
                            <Label text="系统管理" style="-fx-text-fill: #757575; -fx-font-size: 11px;">
                                <VBox.margin>
                                    <Insets left="25.0" bottom="5.0"/>
                                </VBox.margin>
                            </Label>
                            <Button fx:id="btnAdminList" onAction="#showAdminListView" prefHeight="50.0" prefWidth="220.0"
                                    text=" 🔑 管理员维护" styleClass="nav-button"/>
                        </children>
                    </VBox>

                    <Button fx:id="btnSettings" onAction="#showSettingView" prefHeight="50.0" prefWidth="220.0"
                            text=" ⚙ 系统设置" styleClass="nav-button"/>

                    <Region VBox.vgrow="ALWAYS"/>
                    <Separator opacity="0.2"/>
                    <Button fx:id="btnExit" onAction="#handleExit" prefHeight="50.0" prefWidth="220.0" text=" 🚪 退出系统"
                            styleClass="nav-button-exit"/>
                </children>
            </VBox>
        </left>

        <center>
            <StackPane fx:id="contentArea" styleClass="content-area">
                <children>
                    <Label text="请从左侧选择功能模块" styleClass="placeholder-label">
                        <font>
                            <Font size="20.0"/>
                        </font>
                    </Label>
                </children>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>