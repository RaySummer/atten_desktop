<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/8.0.171"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.ray.atten.desktop.presentation.controller.DeviceManagementController"
           prefHeight="700.0" prefWidth="1000.0"
           styleClass="main-content-pane">

    <VBox spacing="15.0">
        <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
        </padding>
        <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <children>
                    <Label text="查询设备:" styleClass="normal-label"/>
                    <TextField fx:id="searchSn" prefWidth="180.0" promptText="输入设备序列号..." styleClass="custom-text-field"/>
                    <ComboBox fx:id="activeFilter" prefWidth="100.0" styleClass="custom-combo-box"/>
                    <Button onAction="#handleSearch" styleClass="accent-button" text="查询"/>
                    <Button onAction="#handleNewDevice" styleClass="accent-button" text="新增设备"/>
                    <Button onAction="#handleSynchronize" styleClass="accent-button" text="同步考勤数据"/>
                </children>
            </HBox>

            <Separator/>

            <AnchorPane fx:id="tableContainer" VBox.vgrow="ALWAYS"/>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <children>
                    <Label fx:id="statusLabel" text="准备就绪" styleClass="muted-label"/>
                </children>
            </HBox>
        </children>
    </VBox>

    <AnchorPane fx:id="drawerPane" onMouseClicked="#handleOverlayClick"
                visible="false" style="-fx-background-color: rgba(0,0,0,0.1);"
                mouseTransparent="true">
        <children>
            <VBox fx:id="drawerContent" prefWidth="550.0" styleClass="side-drawer"
                  AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                <children>
                    <StackPane fx:id="detailContainer" VBox.vgrow="ALWAYS">
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                        </padding>
                    </StackPane>
                </children>
            </VBox>
        </children>
    </AnchorPane>

</StackPane>