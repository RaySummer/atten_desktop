<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ray.atten.desktop.presentation.controller.CameraPreviewController"
      prefHeight="750.0" prefWidth="500.0" alignment="TOP_CENTER"
      styleClass="main-content-pane"> <children>
    <StackPane fx:id="previewStackPane" prefHeight="700.0" prefWidth="500.0" styleClass="camera-preview-container">
        <children>
            <ImageView fx:id="videoImageView" fitHeight="640.0" fitWidth="480.0" preserveRatio="true" />
        </children>
    </StackPane>

    <HBox alignment="CENTER" prefHeight="50.0" prefWidth="500.0" styleClass="camera-controls-bar">
        <children>
            <StackPane HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT" >
                <children>
                    <Button fx:id="btnCapture" text="拍照" minWidth="120.0" onAction="#handleCapture" styleClass="accent-button" />
                    <Button fx:id="btnRetake" text="重拍" minWidth="120.0" onAction="#handleRetake" visible="false" styleClass="normal-button" />
                </children>
            </StackPane>

            <StackPane HBox.hgrow="ALWAYS" alignment="CENTER" >
                <children>
                    <Button fx:id="btnConfirm" text="确定" minWidth="120.0" onAction="#handleConfirm" visible="false" styleClass="accent-button" />
                </children>
            </StackPane>

            <StackPane HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" >
                <children>
                    <Button fx:id="btnCancel" text="取消" minWidth="120.0" onAction="#handleCancel" styleClass="normal-button" />
                </children>
            </StackPane>
        </children>
    </HBox>
</children>
</VBox>