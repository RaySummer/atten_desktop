<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ray.atten.desktop.presentation.controller.FingerprintCaptureController"
      prefHeight="500.0" prefWidth="600.0" styleClass="main-content-pane"> <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
</padding>

    <Label text="指紋錄入與比對" styleClass="header-label" alignment="TOP_CENTER"/>
    <Separator VBox.vgrow="NEVER"/>

    <HBox alignment="TOP_LEFT" spacing="20" VBox.vgrow="ALWAYS" style="-fx-padding: 20 0 0 0;">

        <VBox alignment="CENTER" spacing="10">
            <Label fx:id="statusMessageLabel" text="等待設備連接..." styleClass="status-label-important"/>

            <ImageView fx:id="fingerprintDisplay" fitWidth="200.0" fitHeight="320.0"
                       pickOnBounds="true" preserveRatio="false"
                       styleClass="image-view-border"> </ImageView>
            <Label text="指紋圖像" styleClass="muted-label"/>
        </VBox>

        <VBox alignment="TOP_LEFT" spacing="15" HBox.hgrow="ALWAYS" style="-fx-padding: 0 0 0 10;">

            <GridPane hgap="10" vgap="5">
                <Label text="PIN 碼:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="normal-label"/>
                <Label fx:id="pinLabel" text="[N/A]" GridPane.columnIndex="1" GridPane.rowIndex="0"
                       styleClass="bold-label"/>

                <Label text="姓名:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="normal-label"/>
                <Label fx:id="nameLabel" text="[未設置]" GridPane.columnIndex="1" GridPane.rowIndex="1"
                       styleClass="bold-label"/>
            </GridPane>

            <Separator/>

            <VBox spacing="10" alignment="TOP_LEFT" style="-fx-padding: 10 0 0 0;">
                <Label text="操作:" styleClass="bold-label"/>

                <Button fx:id="reconnectButton" text="嘗試重連設備" prefWidth="150.0"
                        onAction="#handleReconnect" visible="false" styleClass="normal-button"/>

                <Button fx:id="captureButton" text="采集指紋" prefWidth="150.0"
                        onAction="#handleCaptureFingerprint" disable="true" styleClass="accent-button"/>

                <Button fx:id="verifyButton" text="比對指紋" prefWidth="150.0"
                        onAction="#handleVerifyFingerprint" disable="true" styleClass="normal-button"/>
            </VBox>
        </VBox>
    </HBox>

    <Separator VBox.vgrow="NEVER" style="-fx-padding: 10 0 10 0;"/>

    <HBox alignment="CENTER_RIGHT" spacing="10" VBox.vgrow="NEVER">
        <Button fx:id="saveButton" text="保存指紋" prefWidth="100.0" onAction="#handleSaveFingerprint" disable="true" styleClass="accent-button"/>
        <Button fx:id="cancelButton" text="取消" prefWidth="100.0" onAction="#handleCancel" styleClass="normal-button"/>
    </HBox>

</VBox>