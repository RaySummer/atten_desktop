<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/8.0.171"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.ray.atten.desktop.presentation.controller.AdminListController"
           styleClass="main-content-pane">

    <VBox spacing="15.0">
        <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
        </padding>
        <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <children>
                  <!--  <Label text="用户名:" styleClass="normal-label"/>
                    <TextField fx:id="searchField" prefWidth="200.0" promptText="搜索管理员用户名..."
                               styleClass="custom-text-field"/>
                    <Button onAction="#handleSearch" styleClass="accent-button" text="查询" />-->

                    <Region HBox.hgrow="ALWAYS"/>
                    <Button onAction="#handleAddAdmin" styleClass="accent-button" text="➕ 新增管理员"/>
                </children>
            </HBox>

            <Separator/>

            <TableView fx:id="adminTable" VBox.vgrow="ALWAYS" styleClass="custom-table-view">
                <columns>
                    <TableColumn fx:id="colUsername" text="用户名" prefWidth="150.0"/>
                    <TableColumn fx:id="colIsSuper" text="超级管理员" prefWidth="100.0"/>
                    <TableColumn fx:id="colCompanies" text="管辖公司" prefWidth="600.0"/>
                    <TableColumn fx:id="colCreateTime" text="创建时间" prefWidth="200.0"/>
                    <TableColumn fx:id="colAction" text="操作" prefWidth="200.0" />
                </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <children>
                    <Label fx:id="statusLabel" text="共 0 条记录" styleClass="muted-label"/>
                </children>
            </HBox>
        </children>
    </VBox>

    <AnchorPane fx:id="drawerPane" onMouseClicked="#handleOverlayClick"
                visible="false" style="-fx-background-color: rgba(0,0,0,0.2);">
        <children>
            <VBox fx:id="drawerContent" prefWidth="650.0" styleClass="side-drawer"
                  AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                <children>
                   <!-- <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 15;">
                        <Label text="管理员详情" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="✕" onAction="#closeDrawer" style="-fx-background-color: transparent;"/>
                    </HBox>-->

                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                        <StackPane fx:id="formContainer">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                            </padding>
                        </StackPane>
                    </ScrollPane>
                </children>
            </VBox>
        </children>
    </AnchorPane>
</StackPane>