<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="rootPane" style="-fx-background-color: rgba(0, 0, 0, 0.3);"
           xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.ray.atten.desktop.presentation.controller.LoadingController">

    <VBox alignment="CENTER" spacing="15.0" maxWidth="200" maxHeight="150"
          style="-fx-background-color: -fx-base-bg; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 0);">
        <padding>
            <Insets top="20" right="30" bottom="20" left="30"/>
        </padding>

        <ProgressIndicator fx:id="spinner" prefHeight="50.0" prefWidth="50.0" />

        <Label fx:id="msgLabel" text="请稍等..." style="-fx-font-size: 14px; -fx-text-fill: -fx-text-main;" />

        <Button fx:id="retryBtn" text="重试" visible="false" managed="false"
                onAction="#handleRetry" styleClass="btn-primary" />
    </VBox>
</StackPane>