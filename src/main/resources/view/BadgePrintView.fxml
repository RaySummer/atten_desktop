<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ray.atten.desktop.presentation.controller.BadgePrintController"
      fx:id="rootPane"
      prefHeight="500.0" prefWidth="700.0"
      styleClass="main-content-pane">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <padding>
            <Insets bottom="15.0"/>
        </padding>
        <Label text="选择工牌模板:" styleClass="normal-label"/>
        <ComboBox fx:id="templateComboBox" prefWidth="250.0" promptText="请选择打印模板..." styleClass="custom-combo-box"/>

        <HBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT">
            <Button fx:id="previewButton" text="生成打印预览" onAction="#handleGeneratePreview"
                    disable="true" styleClass="accent-button"/>
        </HBox>
    </HBox>

    <VBox VBox.vgrow="ALWAYS" spacing="10.0">
        <Label text="待打印员工清单:" styleClass="muted-label" style="-fx-font-size: 12px;"/>
        <TableView fx:id="employeeTableView" VBox.vgrow="ALWAYS" styleClass="custom-table-view">
            <columns>
                <TableColumn fx:id="rowNumberColumn" text="序号" prefWidth="50" minWidth="50" maxWidth="50"/>
                <TableColumn fx:id="pinColumn" text="工号" prefWidth="80"/>
                <TableColumn fx:id="nameColumn" text="姓名" prefWidth="100"/>
                <TableColumn fx:id="deptColumn" text="部门" prefWidth="120"/>
                <TableColumn fx:id="postColumn" text="职务" prefWidth="100"/>
                <TableColumn fx:id="entryDateColumn" text="入职时间" prefWidth="130"/>
                <TableColumn fx:id="actionColumn" text="操作" prefWidth="80" minWidth="80" maxWidth="80"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

    <HBox alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
        <Label fx:id="countLabel" text="已选择 0 位员工" styleClass="muted-label"/>
    </HBox>

</VBox>