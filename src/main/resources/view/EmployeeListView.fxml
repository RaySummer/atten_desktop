<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/8.0.261"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ray.atten.desktop.presentation.controller.EmployeeListController"
      spacing="15"
      prefWidth="950"
      prefHeight="650"
      styleClass="main-content-pane"> <padding>
    <Insets top="15" right="15" bottom="15" left="15" />
</padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="查詢員工 (PIN/姓名):" styleClass="normal-label"/>
        <TextField fx:id="queryField"
                   promptText="輸入 PIN 碼或姓名進行模糊查詢..."
                   prefWidth="200"
                   styleClass="custom-text-field"/>
        <Label text="狀態:" styleClass="normal-label"/>
        <ChoiceBox fx:id="statusChoiceBox" prefWidth="120" styleClass="custom-choice-box"/>

        <Button text="查詢"
                onAction="#handleSearch"
                styleClass="accent-button"/>
        <Button fx:id="batchSyncButton" text="批量同步" onAction="#handleBatchSynchronize"
                styleClass="accent-button"/>
    </HBox>

    <Separator />

    <Label text="查詢結果列表" styleClass="header-label"/>

    <Pagination fx:id="pagination" VBox.vgrow="ALWAYS" />

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Label text="每頁顯示數量:" styleClass="normal-label"/>
        <ComboBox fx:id="pageSizeComboBox" prefWidth="80" styleClass="custom-combo-box"/>

        <Region HBox.hgrow="ALWAYS" />

        <Label fx:id="statusLabel" text="準備就緒..." styleClass="muted-label"/>
    </HBox>

</VBox>