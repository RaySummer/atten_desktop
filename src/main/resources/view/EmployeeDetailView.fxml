<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ray.atten.desktop.presentation.controller.EmployeeDetailController"
      prefHeight="680.0" prefWidth="650.0"
      styleClass="detail-root-pane"> <padding>
    <Insets bottom="25.0" left="30.0" right="30.0" top="30.0"/>
</padding>

    <HBox spacing="40.0" VBox.vgrow="ALWAYS">
        <children>
            <VBox alignment="TOP_CENTER" spacing="12.0">
                <children>
                    <StackPane styleClass="image-container-box">
                        <ImageView fx:id="photoImageView" fitHeight="300.0" fitWidth="200.0"
                                   pickOnBounds="true" preserveRatio="false"
                                   onMouseClicked="#handleImageClickToZoom"/>
                    </StackPane>

                    <VBox alignment="BOTTOM_CENTER" spacing="8.0">
                        <children>
                            <StackPane styleClass="finger-image-box" maxWidth="180" maxHeight="220">
                                <ImageView fx:id="fingerprint1ImageView" fitHeight="200.0" fitWidth="180.0"
                                           onMouseClicked="#handleFingerprintClickToZoom"
                                           pickOnBounds="true" preserveRatio="true"/>
                            </StackPane>
                        </children>
                    </VBox>
                </children>
            </VBox>

            <VBox spacing="18.0" HBox.hgrow="ALWAYS">
                <children>
                    <VBox spacing="10.0">
                        <children>
                            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="info-row-item">
                                <Label text="       工号:" styleClass="info-label" prefWidth="80"/>
                                <Label fx:id="pinLabel" text="20067" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="value-label"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="info-row-item">
                                <Label text="       姓名:" styleClass="info-label" prefWidth="80"/>
                                <Label fx:id="nameLabel" text="[未设置]" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="value-label"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="info-row-item">
                                <Label text="       部门:" styleClass="info-label" prefWidth="80"/>
                                <Label fx:id="deptLabel" text="[待加载]" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="value-label"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="info-row-item">
                                <Label text="       状态:" styleClass="info-label" prefWidth="80"/>
                                <Label fx:id="statusLabel" text="在职" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="value-label"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="info-row-item">
                                <Label text="办公地点:" styleClass="info-label" prefWidth="80"/>
                                <Label fx:id="officeLocationLabel" text="[待加载]" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="value-label"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="info-row-item">
                                <Label text="入职时间:" styleClass="info-label" prefWidth="80"/>
                                <Label fx:id="entryDateLabel" text="[待加载]" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="value-label"/>
                            </HBox>
                        </children>
                    </VBox>

                    <VBox spacing="10.0">
                        <children>
                            <Button fx:id="captureButton" onAction="#handleCapturePhoto"
                                    maxWidth="Infinity" minHeight="35.0" text="📷 拍照录入"
                                    styleClass="action-btn-styled"/>
                            <Button fx:id="uploadButton" onAction="#handleUploadPhoto"
                                    maxWidth="Infinity" minHeight="35.0" text="📤 上传照片"
                                    styleClass="action-btn-styled"/>
                        </children>
                    </VBox>



                    <VBox spacing="10.0" VBox.vgrow="ALWAYS" alignment="BOTTOM_CENTER">
                        <children>
                            <Label fx:id="lblMessage" alignment="TOP_CENTER" wrapText="true" minHeight="60.0"
                                   text="提示语：设备连接失败/ 指纹录入失败/ 指纹比对不成功"
                                   styleClass="status-message-red"/>
                            <Button fx:id="reconnectButton" onAction="#handleReconnectDevice"
                                    maxWidth="Infinity" minHeight="35.0" text="🔄 重连设备"
                                    styleClass="action-btn-styled"/>
                            <Button fx:id="enrollButton" onAction="#handleFingerEnroll"
                                    maxWidth="Infinity" minHeight="35.0" text="📤 指纹录入"
                                    styleClass="action-btn-styled"/>
                            <Button fx:id="verifyButton" onAction="#handleFingerVerify"
                                    maxWidth="Infinity" minHeight="35.0" text="🔍 指纹比对"
                                    styleClass="action-btn-styled"/>
                        </children>
                    </VBox>
                </children>
            </VBox>
        </children>
    </HBox>

    <HBox alignment="CENTER_RIGHT" spacing="20.0" style="-fx-padding: 30 0 0 0;">
        <children>
            <Button fx:id="confirmButton" onAction="#handleConfirm"
                    text="确定" prefWidth="130.0" prefHeight="40.0"
                    styleClass="primary-confirm-button"/>
            <Button fx:id="cancelButton" onAction="#handleCancel"
                    text="取消" prefWidth="130.0" prefHeight="40.0"
                    styleClass="secondary-cancel-button"/>
        </children>
    </HBox>
</VBox>