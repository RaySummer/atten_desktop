<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.ray.atten</groupId>
  <artifactId>atten_desktop</artifactId>
  <version>1.0.0</version>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <includes>
          <include>**/*.fxml</include>
          <include>**/*.properties</include>
          <include>**/*.png</include>
          <include>**/*.jpg</include>
          <include>**/*.css</include>
          <include>lib/*.jar</include>
          <include>lib/*.dll</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>shaded</shadedClassifierName>
              <includeSystemScope>true</includeSystemScope>
              <artifactSet>
                <includes>
                  <include>*:*</include>
                </includes>
              </artifactSet>
              <transformers>
                <transformer>
                  <mainClass>com.ray.atten.desktop.AppLauncher</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.panteleyev</groupId>
        <artifactId>jpackage-maven-plugin</artifactId>
        <version>1.7.0</version>
        <executions>
          <execution>
            <id>make-installer</id>
            <phase>package</phase>
            <goals>
              <goal>jpackage</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <name>AttenDesktop</name>
          <vendor>Ray Technology</vendor>
          <appVersion>${project.version}</appVersion>
          <destination>${project.build.directory}/jpackage-output</destination>
          <input>${project.build.directory}</input>
          <mainClass>com.ray.atten.desktop.AppLauncher</mainClass>
          <mainJar>atten_desktop-${project.version}-shaded.jar</mainJar>
          <installerType>exe</installerType>
          <winShortcut>true</winShortcut>
          <winMenu>true</winMenu>
          <resourceDir>src/main/resources/lib</resourceDir>
          <javaOptions>
            <option>--add-opens=java.xml.crypto/com.sun.org.slf4j.internal=ALL-UNNAMED</option>
            <option>--add-opens=java.base/sun.nio.ch=ALL-UNNAMED</option>
          </javaOptions>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <dependencies>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.24</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.zkteco</groupId>
      <artifactId>biometric</artifactId>
      <version>1.0.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/src/main/resources/lib/ZKFingerReader.jar</systemPath>
    </dependency>
  </dependencies>
  <properties>
    <commons.version>3.12.0</commons.version>
    <jackson.version>2.12.3</jackson.version>
    <httpclient.version>4.5.13</httpclient.version>
    <jackson-datatype-jsr310.version>2.17.0</jackson-datatype-jsr310.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>17.0.2</javafx.version>
    <slf4j-simple.version>1.7.36</slf4j-simple.version>
    <maven.compiler.source>1.8</maven.compiler.source>
    <spring.version>5.3.23</spring.version>
    <webcam-capture.version>0.3.12</webcam-capture.version>
    <httpcore.version>4.4.13</httpcore.version>
    <lombok.version>1.18.24</lombok.version>
    <jackson-databind.version>2.17.0</jackson-databind.version>
    <maven.compiler.target>1.8</maven.compiler.target>
  </properties>
</project>
